# --- LLM gateway (OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_CACHE=1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nitivayu_user:nitivayu_secure_password@localhost:5433/nitivayu_db
POSTGRES_DB=nitivayu_db
POSTGRES_USER=nitivayu_user
POSTGRES_PASSWORD=nitivayu_secure_password

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- Temporal ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Backend ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_BYTES=5000000
OUTPUT_ROOT=./output

# --- Frontend (Vite; only needed for non-proxied setups) ---
# VITE_API_URL=/api/v1

# --- Phase-1 identity (nitivayu.md §5.5): OTP delivery log|msg91|twilio ---
SMS_PROVIDER=log
ALLOW_DEV_OTP=true
OTP_TTL_SECONDS=600
INVITE_TTL_DAYS=7

# --- Social login (env-gated; API answers 501 until set) ---
OAUTH_CALLBACK_BASE=http://localhost:8000
OAUTH_FRONTEND_BASE=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Object storage (MinIO self-hosted or S3) ---
S3_ENABLED=false
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=nitivayu-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Redis (cache / sessions / rate-limit / SSE fan-out) ---
REDIS_URL=redis://redis:6379/0
ANALYTICS_CACHE_TTL_SECONDS=60
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_SUBMIT_PER_MIN=30

# --- Pooling (point the API at PgBouncer when set) ---
# PGBOUNCER_URL=postgresql+asyncpg://nitivayu_user:nitivayu_secure_password@pgbouncer:6432/nitivayu_db

# --- Media pipeline ---
ASR_ENABLED=false
MODERATION_ENABLED=false
