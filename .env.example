OPENROUTER_API_KEY=  # paste your own key from https://openrouter.ai/keys — never commit a real key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
POSTGRES_DB=nitivayu_db
POSTGRES_USER=nitivayu_user
POSTGRES_PASSWORD=nitivayu_secure_password
JWT_SECRET=nitivayu_super_secret_jwt_key_2026
LLM_CACHE=1
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# --- Phase-1 identity (nitivayu.md §5.5) ---
# OTP delivery: log (dev/demo) | msg91 | twilio
SMS_PROVIDER=log
ALLOW_DEV_OTP=true
OTP_TTL_SECONDS=600
INVITE_TTL_DAYS=7

# --- Reporter notifications: mail + SMS (empty = log-only dev mode) ---
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=<16-char app password> SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@nitivayu.local
SMTP_USE_TLS=true
# Twilio: account SID + auth token + a Twilio phone number in TWILIO_FROM.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MSG91: authkey + sender ID + route; DLT template id for India delivery.
MSG91_AUTH_KEY=
MSG91_SENDER=NITIVU
MSG91_ROUTE=4
MSG91_DLT_TEMPLATE_ID=

# --- Social login (env-gated; API answers 501 until set) ---
# Google-only deployment (owner U4). Paste values from Google Cloud Console
# (OAuth client, type Web application); redirect URI must be
# ${OAUTH_CALLBACK_BASE}/api/v1/auth/oauth/google/callback.
OAUTH_CALLBACK_BASE=http://localhost:8000
OAUTH_FRONTEND_BASE=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook is retired (Graph v18.0 deprecated) — do not set FACEBOOK_*.

# --- Object storage: MinIO (self-hosted) or S3 ---
S3_ENABLED=false
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=nitivayu-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Redis: cache / sessions / rate-limit / SSE fan-out ---
REDIS_URL=redis://redis:6379/0
ANALYTICS_CACHE_TTL_SECONDS=60
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_SUBMIT_PER_MIN=30

# --- Pooling: point the API at PgBouncer when set ---
# PGBOUNCER_URL=postgresql+asyncpg://nitivayu_user:nitivayu_secure_password@pgbouncer:6432/nitivayu_db

# --- Media pipeline ---
ASR_ENABLED=false
MODERATION_ENABLED=false

# --- Local file reports (CSV/PDF/audit mirror; object-storage copy when S3 on) ---
OUTPUT_ROOT=/app/output
MEDIA_DIR=/app/output/media
